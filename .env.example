# Copy to .env. This file is read by build.ps1 only, never bundled as an asset.
# Certificates and passwords are local. Do not commit the filled .env.
APP_DEVELOPER=Your Name
APP_ORGANIZATION=Your Organization
SIGNING_PFX_PATH=.local/signing/OrientMark-code-signing.pfx
SIGNING_PFX_PASSWORD=replace-with-your-local-password
# Optional RFC 3161 timestamp service for a trusted signing certificate.
SIGNING_TIMESTAMP_URL=
